DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loan_app?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARACTERS"
# Development only; use authenticated private object storage before deploying to serverless
PRIVATE_UPLOAD_DIR=".private-uploads"
