generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  // Historical anonymous drafts retain this column; no automatic transfer.
  ownerHash String   @default("")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  encrypted String   @db.Text
  iv        String
  tag       String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]

  @@index([ownerHash])
  @@index([userId, status])
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category      String
  fileName      String
  mime          String
  bytes         Int
  diskPath      String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// Persistent, atomic fixed-window rate limits.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
