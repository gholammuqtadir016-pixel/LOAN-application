generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  sessionVersion Int @default(0)
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  // Historical anonymous drafts retain this column; no automatic transfer.
  ownerHash String   @default("")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  encrypted String   @db.Text
  iv        String
  tag       String
  status    String   @default("DRAFT")
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]

  @@index([ownerHash])
  @@index([userId, status])
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category      String
  fileName      String
  mime          String
  bytes         Int
  diskPath      String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// Persistent, atomic fixed-window rate limits.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

// Never store credentials, PAN/Aadhaar, draft contents or raw IPs here.
model SecurityAudit {
  id            String   @id @default(cuid())
  actorId       String?
  applicationId String?
  action        String
  outcome       String
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([applicationId, createdAt])
}

// Store ONLY SHA-256 token digests; never store raw reset tokens.
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}
